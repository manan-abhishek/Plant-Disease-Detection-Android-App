<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4c775c"
    android:paddingTop="70dp"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    >



    <TextView
        android:id="@+id/appTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Plant AI!"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp" />


    <TextView
        android:id="@+id/appDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recognition of Plant Diseases."
        android:textSize="16sp"
        android:textColor="#DDEEE0"
        app:layout_constraintTop_toBottomOf="@id/appTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />


    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="320dp"
        android:layout_height="269dp"
        android:contentDescription="App Logo"
        android:src="@drawable/appphoto"
        app:layout_constraintTop_toBottomOf="@id/appDesc"
        app:layout_constraintBottom_toTopOf="@+id/feature1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.1" />


    <TextView
        android:id="@+id/feature1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Track Plant Diseases"
        android:textColor="#ffffff"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp" />


    <TextView
        android:id="@+id/feature2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Manage Plant with AI"
        android:textColor="#ffffff"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/feature1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp" />


    <TextView
        android:id="@+id/feature3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="• Prevent diseases early"
        android:textColor="#ffffff"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/feature2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp" />


    <Button
        android:id="@+id/btnGetStarted"
        android:layout_width="0dp"
        android:layout_height="57dp"
        android:backgroundTint="#fdf7e5"
        android:elevation="4dp"
        android:stateListAnimator="@null"
        android:text="Get Started"
        android:textColor="#4F6F52"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/feature3"
        app:layout_constraintVertical_bias="0.666" />

</androidx.constraintlayout.widget.ConstraintLayout>
